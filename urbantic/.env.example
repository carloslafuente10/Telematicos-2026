# PostgreSQL database name used by the database service.
POSTGRES_DB=urbantic

# PostgreSQL application user.
POSTGRES_USER=urbantic_user

# PostgreSQL application password. Replace before using outside local development.
POSTGRES_PASSWORD=change_me_database_password

# Backend connection string. The host must be "database" inside Docker Compose.
DATABASE_URL=postgresql://urbantic_user:change_me_database_password@database:5432/urbantic

# JWT signing secret. Replace with a long random value.
JWT_SECRET=change_me_jwt_secret

# JWT expiration time.
JWT_EXPIRES_IN=8h

# Public backend port exposed on the host.
BACKEND_PORT=4000

# Frontend URL allowed by CORS.
FRONTEND_URL=http://localhost:8081

# API URL compiled into the Vite frontend.
VITE_API_URL=http://localhost:4000/api
